# NASA FIRMS API Map Key (get one free at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=DEMO_KEY

# Data source: synthetic | live | hybrid
DATA_SOURCE=synthetic

# Synthetic generator settings
SYNTHETIC_SEED=42
SYNTHETIC_DAYS=30

# Default bounding box (W,S,E,N) - India
DEFAULT_BBOX=68.1,6.7,97.4,35.5

# CORS: comma-separated list of allowed origins, or * to allow all
ALLOWED_ORIGINS=*

# Risk score weights (must sum to 1.0)
RISK_WEIGHT_INTENSITY=0.30
RISK_WEIGHT_WIND=0.25
RISK_WEIGHT_FUEL=0.25
RISK_WEIGHT_EXPOSURE=0.10
RISK_WEIGHT_PERSISTENCE=0.10
